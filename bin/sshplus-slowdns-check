#!/usr/bin/env bash
set -euo pipefail
listen="${1:-}"
mtu="${2:-}"
domain="${3:-}"
upstream="${4:-}"

valid_ipv4() {
    local ip="$1" octet
    [[ "$ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 1
    IFS='.' read -r -a octets <<< "$ip"
    for octet in "${octets[@]}"; do
        (( 10#$octet >= 0 && 10#$octet <= 255 )) || return 1
    done
}

valid_domain() {
    local value="${1,,}" label
    [[ -n "$value" && ${#value} -le 253 && "$value" == *.* && "$value" != .* && "$value" != *. ]] || return 1
    IFS='.' read -r -a labels <<< "$value"
    for label in "${labels[@]}"; do
        [[ -n "$label" && ${#label} -le 63 ]] || return 1
        [[ "$label" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]] || return 1
    done
}

[[ "$listen" =~ ^(([0-9]{1,3}\.){3}[0-9]{1,3}):([0-9]{1,5})$ ]]
listen_ip="${BASH_REMATCH[1]}"
port="${BASH_REMATCH[3]}"
valid_ipv4 "$listen_ip"
(( 10#$port >= 1 && 10#$port <= 65535 ))
[[ "$mtu" =~ ^[0-9]+$ ]]
(( 10#$mtu >= 512 && 10#$mtu <= 1232 ))
valid_domain "$domain"
[[ "$upstream" =~ ^127\.0\.0\.1:([0-9]{1,5})$ ]]
upstream_port="${BASH_REMATCH[1]}"
(( 10#$upstream_port >= 1 && 10#$upstream_port <= 65535 ))
[[ -r /etc/slowdns/server.key ]]
